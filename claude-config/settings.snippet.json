{
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "@TASK_TRACK@"
  },
  "permissions": {
    "additionalDirectories": [
      "~/vault"
    ],
    "allow": [
      "Bash(obsidian:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/load-task.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "date '+Now: %H:%M'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
