      "summary": "Personal",
      "colorId": "2",
      "for": ["personal", "event", "appointment"],
      "needs_id": true
    },
    "family": {
      "id": "",
      "summary": "Family",
      "colorId": "5",
      "for": ["family"],
      "needs_id": true
    },
    "birthdays": {
      "id": "",
