filters:
  and:
    - file.inFolder("Tasks")
properties:
  note.up:
    displayName: Project
views:
  - type: table
    name: Active
    filters:
      and:
        - status == "active"
    order:
      - file.name
      - up
      - started
    sort:
      - property: started
        direction: DESC
  - type: table
    name: Parked
    filters:
      and:
        - status == "parked"
    order:
      - file.name
      - up
      - started
  - type: table
    name: Done
    filters:
      and:
        - status == "done"
    order:
      - file.name
      - up
      - started
  - type: kanban-view
    name: Board
    filters:
      or:
        - status != "done"
        - finished >= today() - "6 days"
    groupByProperty: note.status
    columnOrders:
      note.status:
        - parked
        - active
        - done
    order:
      - up
      - started
  - type: table
    name: Done (7 days)
    filters:
      and:
        - status == "done"
        - finished >= today() - "6 days"
    order:
      - file.name
      - up
      - finished
    sort:
      - property: finished
        direction: DESC
